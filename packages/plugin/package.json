{
  "name": "dsh-life-saver",
  "version": "0.8.1",
  "description": "Zentao (禅道) content extraction for DeepSeek Harness: pull task/bug/story bodies, comments, action history, attachment entities and linked requirements via a read-only MariaDB + SFTP channel or an account-password HTTP channel, with a web settings page.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaminof3tt/dsh-life-saver.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/kaminof3tt/dsh-life-saver#readme",
  "bugs": {
    "url": "https://github.com/kaminof3tt/dsh-life-saver/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "npm run typecheck:host && npm run typecheck:client",
    "typecheck:host": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "lint": "eslint .",
    "pretest": "pnpm build",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "zentao",
    "禅道"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "life-saver-core": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    }
  }
}
