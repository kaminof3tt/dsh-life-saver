{
  // 客户端半侧（src/client/index.jsx）的类型检查配置。
  //
  // 为什么不并进 tsconfig.json：宿主侧是 Node ESM + module: NodeNext，客户端是浏览器 +
  // esbuild 打包的 __ModuleLoader__ 形态，编译目标不同；而且客户端是 .jsx（不是 .ts），
  // 必须单独开 checkJs 才谈得上「检查」。
  //
  // 为什么必须存在：这个文件以前没有任何脚本引用它、也没开 allowJs，真跑起来直接
  // error TS18003: No inputs were found —— 等于 1600 多行 JSX 完全没人检查。结果就是
  // TargetCard 里引用 map 外的变量（repo）这种事一路裸奔到用户面前白屏。
  //
  // noImplicitAny: false 是刻意的取舍：这个文件是 JS，参数大多没标注，全开会有 130 多条
  // 「隐式 any」噪音，把真错误（未定义变量、属性不存在、可空未判）淹掉。关掉之后噪音
  // 归零，剩下的每一条都是真问题。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/client/**/*"]
}
