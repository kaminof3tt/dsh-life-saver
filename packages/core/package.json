{
  "name": "life-saver-core",
  "version": "0.8.1",
  "description": "Zentao (禅道) content channel core: read/write task, bug, story bodies, comments, action history, attachments and worklogs via a read-only MariaDB + SFTP channel or an account-password HTTP channel. Framework-agnostic — used by dsh-life-saver (DSH plugin) and life-saver-mcp (MCP server).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaminof3tt/dsh-life-saver.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/kaminof3tt/dsh-life-saver/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/kaminof3tt/dsh-life-saver/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./*.js": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "pnpm build",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "zentao",
    "禅道",
    "mariadb",
    "sftp",
    "life-saver",
    "deepseek-harness"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "mysql2": "^3.24.6",
    "node-html-parser": "^7.0.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ssh2": "^1.15.1",
    "typescript": "^5.7.2"
  }
}
