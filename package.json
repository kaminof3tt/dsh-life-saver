{
  "name": "dsh-life-saver-workspace",
  "private": true,
  "version": "0.8.1",
  "description": "pnpm workspace: packages/core = life-saver-core (framework-agnostic Zentao channel core), packages/plugin = dsh-life-saver (DeepSeek Harness plugin shell).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaminof3tt/dsh-life-saver.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "pack:core": "pnpm --filter life-saver-core pack",
    "pack:plugin": "pnpm --filter dsh-life-saver pack"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "^5.7.2"
  }
}
